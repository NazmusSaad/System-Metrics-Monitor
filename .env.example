# Database
POSTGRES_USER=metrics
POSTGRES_PASSWORD=metricspass
POSTGRES_DB=metrics_monitor

# Backend
DATABASE_URL=postgresql+asyncpg://metrics:metricspass@db:5432/metrics_monitor
COLLECTION_INTERVAL_SECONDS=2
MACHINE_NAME=local

# Health thresholds
CPU_WARN=80
CPU_CRIT=95
MEM_WARN=80
MEM_CRIT=95
DISK_WARN=85
DISK_CRIT=95

# V2: Multi-device
INGEST_API_KEY=changeme-secret-key
ENABLE_LOCAL_COLLECTOR=true

# Frontend
VITE_API_URL=http://localhost:8000

# Agent (used on remote devices)
# BACKEND_URL=https://your-backend.onrender.com
# HOST_KEY=laptop-1
# INTERVAL_SECONDS=2
